diff --git a/browser/components/preferences/tests/browser_browser_style.js b/browser/components/preferences/tests/browser_browser_style.js
new file mode 100644
index 00000000..67e9ac88
--- /dev/null
+++ b/browser/components/preferences/tests/browser_browser_style.js
@@ -0,0 +1,115 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+async function test_browser_style_picker(redesignEnabled) {
+  await SpecialPowers.pushPrefEnv({
+    set: [
+      ["browser.settings-redesign.enabled", redesignEnabled],
+      ["browser.nova.enabled", true],
+      ["browser.photon.enabled", false],
+      ["browser.uidensity", 1],
+    ],
+  });
+
+  await openPreferencesViaOpenPreferencesAPI(
+    redesignEnabled ? "appearance" : "general",
+    { leaveOpen: true }
+  );
+  let win = gBrowser.selectedBrowser.contentWindow;
+  let doc = win.document;
+  await TestUtils.waitForCondition(
+    () =>
+      getSettingControl("browserStyle", win)?.controlEl?.children.length == 3,
+    "Wait for the browser style picker"
+  );
+  let control = getSettingControl("browserStyle", win);
+  let picker = control.controlEl;
+  await picker.updateComplete;
+  is(picker.value, "nova", "The picker reflects Nova");
+
+  for (let style of ["photon", "proton", "nova"]) {
+    let item = [...picker.children].find(option => option.value == style);
+    await item.updateComplete;
+    item.click();
+    await TestUtils.waitForCondition(
+      () => control.setting.value == style && picker.value == style,
+      `The picker selects ${style}`
+    );
+    is(
+      Services.prefs.getBoolPref("browser.nova.enabled"),
+      style == "nova",
+      `${style} sets the Nova preference`
+    );
+    is(
+      Services.prefs.getBoolPref("browser.photon.enabled"),
+      style == "photon",
+      `${style} sets the Photon preference`
+    );
+    is(
+      Services.prefs.getIntPref("browser.uidensity"),
+      1,
+      "Density is preserved"
+    );
+    if (redesignEnabled) {
+      let density = getSettingControl("uiDensity", win);
+      await TestUtils.waitForCondition(
+        () => BrowserTestUtils.isHidden(density) == (style != "nova"),
+        "Density options follow the active browser style"
+      );
+    }
+  }
+
+  Services.prefs.setBoolPref("browser.nova.enabled", false);
+  await TestUtils.waitForCondition(
+    () => picker.value == "proton",
+    "The picker observes external Nova changes"
+  );
+  Services.prefs.setBoolPref("browser.photon.enabled", true);
+  await TestUtils.waitForCondition(
+    () => picker.value == "photon",
+    "The picker observes external Photon changes"
+  );
+
+  await doc.l10n.translateFragment(picker);
+  for (let item of picker.children) {
+    await item.updateComplete;
+    ok(item.label, "Each browser style has an accessible label");
+    ok(item.itemEl.getAttribute("aria-checked"), "Each item exposes selection");
+    let image = item.shadowRoot.querySelector("img");
+    await TestUtils.waitForCondition(
+      () => image.complete && image.naturalWidth > 0,
+      "The preview loads"
+    );
+  }
+
+  for (let pref of ["browser.nova.enabled", "browser.photon.enabled"]) {
+    Services.prefs.lockPref(pref);
+    try {
+      await TestUtils.waitForCondition(
+        () => picker.disabled,
+        "Locked style preferences disable the picker"
+      );
+      let value = control.setting.value;
+      control.setting.value = value == "nova" ? "photon" : "nova";
+      is(control.setting.value, value, "A locked preference prevents changes");
+    } finally {
+      Services.prefs.unlockPref(pref);
+    }
+    await TestUtils.waitForCondition(
+      () => !picker.disabled,
+      "Unlocking preferences enables the picker"
+    );
+  }
+
+  await BrowserTestUtils.removeTab(gBrowser.selectedTab);
+}
+
+add_task(async function test_browser_style_picker_legacy() {
+  await test_browser_style_picker(false);
+});
+
+add_task(async function test_browser_style_picker_redesign() {
+  await test_browser_style_picker(true);
+});
