@@ -285,8 +285,23 @@
-:root:not([theme-image-in-toolbox]) body,
-:root[theme-image-in-toolbox] #navigator-toolbox {
-  background-image: var(--toolbox-background-image);
-  background-repeat: var(--toolbox-background-repeat);
-  background-position: var(--toolbox-background-position);
-  /* stylelint-disable-next-line stylelint-plugin-mozilla/use-design-tokens */
-  background-size: var(--toolbox-background-size);
+/* Use Firefox 150's sidebar background behavior when enabled; otherwise keep
+ * the pre-150 toolbox background. */
+@media -moz-pref("browser.theme.background-image-on-sidebar.enabled") {
+  /* Preserve upstream's vertical-alignment behavior. */
+  :root:not([theme-image-in-toolbox]) body,
+  :root[theme-image-in-toolbox] #navigator-toolbox {
+    background-image: var(--toolbox-background-image);
+    background-repeat: var(--toolbox-background-repeat);
+    background-position: var(--toolbox-background-position);
+    /* stylelint-disable-next-line stylelint-plugin-mozilla/use-design-tokens */
+    background-size: var(--toolbox-background-size);
+  }
+}
+
+@media not -moz-pref("browser.theme.background-image-on-sidebar.enabled") {
+  #navigator-toolbox {
+    background-image: var(--toolbox-background-image);
+    background-repeat: var(--toolbox-background-repeat);
+    background-position: var(--toolbox-background-position);
+    /* stylelint-disable-next-line stylelint-plugin-mozilla/use-design-tokens */
+    background-size: var(--toolbox-background-size);
+  }
 }
