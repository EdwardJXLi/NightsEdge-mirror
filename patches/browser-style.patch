@@ -0,0 +1,147 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Adapted from Waterfox's Lepton chrome styles at 9230b1e71d78:
+ * https://github.com/BrowserWorks/Waterfox/tree/9230b1e71d7856ab94c7c619832be653bf7f1d4f/waterfox/browser/themes/lepton
+ * Lepton derives from black7375/Firefox-UI-Fix at 6f02881a25d6. */
+
+@media (not -moz-pref("browser.nova.enabled")) and -moz-pref("browser.photon.enabled") {
+  #tabbrowser-tabs {
+    --tab-border-radius: 4px;
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] {
+    --tab-margin-block: 2px;
+    --tabstrip-min-height: calc(var(--tab-min-height) + var(--tab-margin-block));
+    min-height: var(--tabstrip-min-height);
+  }
+
+  :root[uidensity="touch"] #tabbrowser-tabs[orient="horizontal"] {
+    --tab-margin-block: 4px;
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] .tab-background {
+    position: relative;
+    margin-block-end: 0;
+    border-end-start-radius: 0;
+    border-end-end-radius: 0;
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] tab-split-view-wrapper {
+    margin-block-end: 0;
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] tab-group .tabbrowser-tab:is([selected], [multiselected]) .tab-group-line {
+    transform: translateY(calc(-1 * var(--tab-group-line-thickness)));
+  }
+
+  @media not (forced-colors) {
+    @media not -moz-pref("sidebar.verticalTabs") {
+      :root #nav-bar {
+        border-top: none;
+      }
+    }
+
+    #tabbrowser-tabs[orient="horizontal"] {
+      --tab-box-shadow-selected: none;
+    }
+
+    #tabbrowser-tabs[orient="horizontal"]:not([noshadowfortests]) .tab-background:is([selected], [multiselected]) {
+      filter: drop-shadow(0 0 2px color-mix(in srgb, currentColor 30%, transparent));
+    }
+
+    #tabbrowser-tabs[orient="horizontal"] .tabbrowser-tab[visuallyselected] .tab-background::before,
+    #tabbrowser-tabs[orient="horizontal"] .tabbrowser-tab[visuallyselected] .tab-background::after {
+      content: "";
+      position: absolute;
+      inset-block-end: 0;
+      width: 3px;
+      height: 3px;
+      background-color: var(--tab-background-color-selected);
+      clip-path: path("M 0 3 A 3 3 0 0 0 3 0 L 3 3 Z");
+      pointer-events: none;
+    }
+
+    #tabbrowser-tabs[orient="horizontal"] .tabbrowser-tab[visuallyselected] .tab-background::before {
+      left: -3px;
+    }
+
+    #tabbrowser-tabs[orient="horizontal"] .tabbrowser-tab[visuallyselected] .tab-background::after {
+      right: -3px;
+      transform: scaleX(-1);
+    }
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] .tab-context-line {
+    position: relative;
+    height: 2px;
+    border-start-start-radius: var(--tab-border-radius);
+    border-start-end-radius: var(--tab-border-radius);
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] .tabbrowser-tab:not([usercontextid]) .tab-context-line {
+    background-color: transparent;
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] .tabbrowser-tab:is([selected], [multiselected]):not([usercontextid]) .tab-context-line {
+    background-color: var(--lwt-tab-line-color, var(--focus-outline-color));
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] .tabbrowser-tab:hover:not([selected], [multiselected], [usercontextid]) .tab-context-line {
+    background-color: var(--toolbarseparator-color);
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] .tabbrowser-tab[usercontextid] .tab-context-line {
+    margin: 0;
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] .tab-stack::before,
+  #tabbrowser-tabs[orient="horizontal"] #tabs-newtab-button::before {
+    content: "";
+    position: absolute;
+    inset-block-start: 50%;
+    inset-inline-start: -1px;
+    width: 1px;
+    height: 20px;
+    transform: translateY(-50%);
+    background-color: var(--toolbarseparator-color);
+    opacity: 0;
+    pointer-events: none;
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] .tabbrowser-tab:not([visuallyselected], [multiselected], :hover, :first-of-type) .tab-stack::before,
+  #tabbrowser-tabs[orient="horizontal"] #tabs-newtab-button:not(:hover, [open])::before {
+    opacity: 1;
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] .tabbrowser-tab:is([visuallyselected], [multiselected], :hover) + .tabbrowser-tab .tab-stack::before,
+  #tabbrowser-tabs[orient="horizontal"]
+    .tabbrowser-tab:last-of-type:is([visuallyselected], [multiselected], :hover)
+    ~ #tabbrowser-arrowscrollbox-periphery
+    #tabs-newtab-button::before,
+  #tabbrowser-tabs[orient="horizontal"] tab-group:has(.tabbrowser-tab:last-child:is([selected], :hover)) + .tabbrowser-tab .tab-stack::before,
+  #tabbrowser-tabs[orient="horizontal"] tab-group[collapsed] + .tabbrowser-tab .tab-stack::before {
+    opacity: 0;
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] #tabs-newtab-button {
+    align-items: stretch;
+    padding-block-start: var(--tab-margin-block);
+    padding-block-end: 0;
+  }
+
+  #tabbrowser-tabs[orient="horizontal"] #tabs-newtab-button > .toolbarbutton-icon {
+    border-start-start-radius: var(--tab-border-radius);
+    border-start-end-radius: var(--tab-border-radius);
+    border-end-start-radius: 0;
+    border-end-end-radius: 0;
+  }
+
+  @media (prefers-reduced-motion: no-preference) {
+    #tabbrowser-tabs[orient="horizontal"] .tab-stack::before,
+    #tabbrowser-tabs[orient="horizontal"] #tabs-newtab-button::before {
+      transition: opacity 200ms var(--animation-easing-function);
+    }
+  }
+}
