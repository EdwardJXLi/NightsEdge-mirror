diff --git a/browser/components/preferences/tests/browser_browser_style.js b/browser/components/preferences/tests/browser_browser_style.js
--- a/browser/components/preferences/tests/browser_browser_style.js
+++ b/browser/components/preferences/tests/browser_browser_style.js
@@ -113,3 +113,47 @@ add_task(async function test_browser_style_picker_legacy() {
 add_task(async function test_browser_style_picker_redesign() {
   await test_browser_style_picker(true);
 });
+
+add_task(async function test_browser_style_toolbar_background() {
+  for (let verticalTabs of [true, false]) {
+    await SpecialPowers.pushPrefEnv({
+      set: [
+        ["sidebar.revamp", true],
+        ["sidebar.verticalTabs", verticalTabs],
+        ["browser.tabs.inTitlebar", 1],
+        ["browser.nova.enabled", false],
+        ["browser.photon.enabled", false],
+      ],
+    });
+
+    for (let style of ["photon", "nova", "proton", "nova", "photon"]) {
+      Services.prefs.setBoolPref("browser.photon.enabled", style == "photon");
+      Services.prefs.setBoolPref("browser.nova.enabled", style == "nova");
+
+      let freshWindow = await BrowserTestUtils.openNewBrowserWindow();
+      try {
+        for (let win of [window, freshWindow]) {
+          is(
+            win.document
+              .getElementById("PersonalToolbar")
+              .classList.contains("browser-titlebar"),
+            verticalTabs && win.CustomTitlebar.enabled && style == "nova",
+            `${style} bookmarks titlebar state with vertical tabs ${verticalTabs}`
+          );
+        }
+        is(
+          window.getComputedStyle(document.getElementById("PersonalToolbar"))
+            .backgroundColor,
+          freshWindow.getComputedStyle(
+            freshWindow.document.getElementById("PersonalToolbar")
+          ).backgroundColor,
+          `${style} bookmarks background matches a new window with vertical tabs ${verticalTabs}`
+        );
+      } finally {
+        await BrowserTestUtils.closeWindow(freshWindow);
+      }
+    }
+
+    await SpecialPowers.popPrefEnv();
+  }
+});
