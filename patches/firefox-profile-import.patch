new file mode 100644
index 0000000..76f1193
--- /dev/null
+++ b/browser/components/migration/FirefoxProfileImport.sys.mjs
@@ -0,0 +1,261 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { AppConstants } from "resource://gre/modules/AppConstants.sys.mjs";
+import { FileUtils } from "resource://gre/modules/FileUtils.sys.mjs";
+
+const SKIPPED_PROFILE_ENTRIES = new Set([
+  ".parentlock",
+  "parent.lock",
+  "lock",
+  "addonStartup.json.lz4",
+  "cache2",
+  "startupCache",
+  "minidumps",
+  "signedInUser.json",
+  "weave",
+  "times.json",
+]);
+
+const RESET_IMPORTED_PREFS = new Map([
+  ["browser.profiles.created", false],
+  ["toolkit.profiles.storeID", ""],
+  ["services.sync.username", ""],
+]);
+
+function serializePrefs(prefs) {
+  return (
+    "\n" +
+    [...prefs]
+      .map(
+        ([name, value]) =>
+          `user_pref(${JSON.stringify(name)}, ${JSON.stringify(value)});\n`
+      )
+      .join("")
+  );
+}
+
+async function resetProfileIdentity(destination) {
+  await IOUtils.writeUTF8(
+    PathUtils.join(destination, "prefs.js"),
+    serializePrefs(RESET_IMPORTED_PREFS),
+    { mode: "append" }
+  );
+
+  // user.js loads after prefs.js on every startup. Remove imported identity
+  // overrides from it so later sign-in and profile grouping can persist.
+  const customPrefsPath = PathUtils.join(destination, "user.js");
+  if (!(await IOUtils.exists(customPrefsPath))) {
+    return;
+  }
+  const { PreferencesBackupResource } = ChromeUtils.importESModule(
+    "moz-src:///browser/components/backup/resources/PreferencesBackupResource.sys.mjs"
+  );
+  const prefs = PreferencesBackupResource.getPrefsFromBuffer(
+    await IOUtils.read(customPrefsPath)
+  );
+  const prefCount = prefs.size;
+  for (const name of RESET_IMPORTED_PREFS.keys()) {
+    prefs.delete(name);
+  }
+  if (prefs.size !== prefCount) {
+    await IOUtils.writeUTF8(customPrefsPath, serializePrefs(prefs));
+  }
+}
+
+let importInProgress = false;
+
+async function isLink(file) {
+  if (AppConstants.platform === "win") {
+    const attrs = await IOUtils.getWindowsAttributes(file.path);
+    return attrs.reparsePoint;
+  }
+  return file.isSymlink();
+}
+
+async function copyProfileDirectory(source, destination, skippedEntries) {
+  for (const path of await IOUtils.getChildren(source)) {
+    const entry = new FileUtils.File(path);
+    if (skippedEntries?.has(entry.leafName) || (await isLink(entry))) {
+      continue;
+    }
+
+    const target = PathUtils.join(destination, entry.leafName);
+    if (entry.isDirectory()) {
+      await IOUtils.makeDirectory(target, { permissions: 0o700 });
+      await copyProfileDirectory(path, target);
+    } else if (entry.isFile()) {
+      await IOUtils.copy(path, target, { noOverwrite: true });
+    }
+  }
+}
+
+function getFirefoxProfilesDirectory() {
+  if (AppConstants.platform !== "macosx") {
+    return Services.dirsvc.get("DefProfRt", Ci.nsIFile);
+  }
+
+  const path = Services.dirsvc.get("Home", Ci.nsIFile);
+  path.append("Library");
+  path.append("Application Support");
+  path.append("Firefox");
+  path.append("Profiles");
+  return path;
+}
+
+async function hasUnsafeLockFile(entries) {
+  // Gecko opens the native lock for writing. Only let it open an empty
+  // regular file, or create a new lock when none is present.
+  const filename =
+    AppConstants.platform === "win" ? "parent.lock" : ".parentlock";
+  const lockPath = entries.find(
+    path => PathUtils.filename(path).toLowerCase() === filename
+  );
+  if (!lockPath) {
+    return false;
+  }
+  const lock = new FileUtils.File(lockPath);
+  return (await isLink(lock)) || !lock.isFile() || lock.fileSize !== 0;
+}
+
+async function importProfile(win, alert) {
+  const picker = Cc["@mozilla.org/filepicker;1"].createInstance(
+    Ci.nsIFilePicker
+  );
+  const pickerTitle = await win.document.l10n.formatValue(
+    "preferences-import-firefox-profile-picker"
+  );
+  picker.init(win.browsingContext, pickerTitle, Ci.nsIFilePicker.modeGetFolder);
+  picker.displayDirectory = getFirefoxProfilesDirectory();
+  if (
+    (await new Promise(resolve => picker.open(resolve))) !==
+    Ci.nsIFilePicker.returnOK
+  ) {
+    return;
+  }
+
+  const source = picker.file;
+  if (!source || (await isLink(source))) {
+    await alert("invalid");
+    return;
+  }
+  source.normalize();
+  const profilesDir = Services.dirsvc.get("DefProfRt", Ci.nsIFile);
+  profilesDir.normalize();
+  const currentProfile = Services.dirsvc.get("ProfD", Ci.nsIFile);
+  currentProfile.normalize();
+  const sourcePrefs = source.clone();
+  sourcePrefs.append("prefs.js");
+  if (
+    source.equals(currentProfile) ||
+    source.equals(profilesDir) ||
+    source.contains(profilesDir) ||
+    !sourcePrefs.exists() ||
+    (await isLink(sourcePrefs)) ||
+    !sourcePrefs.isFile()
+  ) {
+    await alert("invalid");
+    return;
+  }
+
+  const profileService = Cc[
+    "@mozilla.org/toolkit/profile-service;1"
+  ].getService(Ci.nsIToolkitProfileService);
+  if (await hasUnsafeLockFile(await IOUtils.getChildren(source.path))) {
+    await alert("locked");
+    return;
+  }
+  let lock;
+  try {
+    lock = profileService.lockProfilePath(source);
+  } catch {
+    await alert("locked");
+    return;
+  }
+
+  let destination;
+  let profile;
+  let previousDefault;
+  try {
+    try {
+      destination = await IOUtils.createUniqueDirectory(
+        profilesDir.path,
+        "firefox-import",
+        0o700
+      );
+      await copyProfileDirectory(
+        source.path,
+        destination,
+        SKIPPED_PROFILE_ENTRIES
+      );
+
+      await resetProfileIdentity(destination);
+    } finally {
+      lock.unlock();
+    }
+
+    const profileName = await win.document.l10n.formatValue(
+      "preferences-import-firefox-profile-name"
+    );
+    profile = profileService.createUniqueProfile(
+      new FileUtils.File(destination),
+      profileName,
+      "firefox-import"
+    );
+    previousDefault = profileService.defaultProfile;
+    if (previousDefault && profileService.currentProfile === previousDefault) {
+      profileService.defaultProfile = profile;
+    }
+    await profileService.asyncFlush();
+  } catch (error) {
+    if (profile) {
+      if (previousDefault && profileService.defaultProfile === profile) {
+        profileService.defaultProfile = previousDefault;
+      }
+      profile.removeInBackground(true);
+    } else if (destination) {
+      await IOUtils.remove(destination, {
+        recursive: true,
+        retryReadonly: true,
+      });
+    }
+    throw error;
+  }
+
+  try {
+    Services.startup.createInstanceWithProfile(profile, []);
+  } catch {
+    await alert("launch-failed");
+  }
+}
+
+/**
+ * Copy a selected Firefox profile to a new profile and open it.
+ *
+ * @param {Window} win The preferences window that opened the picker.
+ */
+export async function importFirefoxProfile(win) {
+  if (importInProgress) {
+    return;
+  }
+
+  importInProgress = true;
+  const alert = async reason => {
+    if (!win.closed) {
+      const [title, message] = await win.document.l10n.formatValues([
+        { id: "preferences-import-firefox-profile-title" },
+        { id: `preferences-import-firefox-profile-${reason}` },
+      ]);
+      Services.prompt.alert(win, title, message);
+    }
+  };
+
+  try {
+    await importProfile(win, alert);
+  } catch {
+    await alert("failed");
+  } finally {
+    importInProgress = false;
+  }
+}
